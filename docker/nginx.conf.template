# nginx server for the rendered site (_site/). The official image's entrypoint renders this
# template into /etc/nginx/conf.d/default.conf, substituting ${PORT} only: nginx's own
# variables ($uri, ...) are not environment variables and pass through untouched.

# HTML is revalidated on every visit so a deploy shows up at once. Scripts and styles change with
# deploys but post_render.py versions the course's own files (?v=...), so a short cache is enough.
map $uri $mm_cache_control {
    default                                     "no-cache";
    ~*\.(?:css|js|mjs|json)$                    "public, max-age=3600";
    ~*\.(?:svg|png|jpe?g|gif|webp|avif|ico)$    "public, max-age=86400";
    ~*\.(?:woff2?|ttf|otf)$                     "public, max-age=604800";
}

server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    server_tokens off;
    # Railway terminates TLS in front of us: keep redirects relative so they never point at
    # http:// or at the internal port.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/xml text/csv text/markdown application/javascript
               application/json application/xml application/rss+xml image/svg+xml;

    # Without "always": error responses (404s) are never cached.
    add_header Cache-Control $mm_cache_control;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
