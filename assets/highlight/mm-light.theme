{
    "_comment": "Molecules & Models syntax theme (light). Every token colour reaches >= 4.5:1 on the code background #F3F5F8; verified by scripts/check_contrast.py.",
    "text-color": "#1B1F27",
    "background-color": "#F3F5F8",
    "line-number-color": "#6B7482",
    "line-number-background-color": "#F3F5F8",
    "text-styles": {
        "Normal":         { "text-color": "#1B1F27", "bold": false, "italic": false, "underline": false },
        "Keyword":        { "text-color": "#5B3FC4", "bold": false, "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#5B3FC4", "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#5B3FC4", "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#3A4150", "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#8A4B00", "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#0B6E63", "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#0A5A8F", "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#0A5A8F", "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#B03A2E", "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#1B1F27", "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#7A5000", "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#7A5000", "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#7A5000", "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#7A5000", "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#1F6E1F", "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#B0205B", "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#1F6E1F", "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#1F6E1F", "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#1F6E1F", "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#5B6573", "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#5B6573", "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#5B6573", "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#5B6573", "bold": false, "italic": true,  "underline": false },
        "Information":    { "text-color": "#0A5A8F", "bold": false, "italic": false, "underline": false },
        "Warning":        { "text-color": "#8A4B00", "bold": false, "italic": false, "underline": false },
        "Alert":          { "text-color": "#B03A2E", "bold": true,  "italic": false, "underline": false },
        "Error":          { "text-color": "#B03A2E", "bold": true,  "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#8A4B00", "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#3B4FBF", "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#3B4FBF", "bold": false, "italic": false, "underline": false }
    }
}
