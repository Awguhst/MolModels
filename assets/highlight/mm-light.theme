{
    "_comment": "Molecules & Models syntax theme (light). Every token colour reaches >= 4.5:1 on the code background #F3F2EE; verified by scripts/check_contrast.py.",
    "text-color": "#1E2228",
    "background-color": "#F3F2EE",
    "line-number-color": "#5F6269",
    "line-number-background-color": "#F3F2EE",
    "text-styles": {
        "Normal":         { "text-color": "#1E2228", "bold": false, "italic": false, "underline": false },
        "Keyword":        { "text-color": "#4E4AA0", "bold": false, "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#4E4AA0", "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#4E4AA0", "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#3A3E45", "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#9A4A14", "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#1B6F62", "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#2C5D9B", "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#2C5D9B", "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#A8365A", "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#1E2228", "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#8C5600", "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#8C5600", "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#8C5600", "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#8C5600", "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#35702A", "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#8A3F7C", "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#35702A", "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#35702A", "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#35702A", "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#5F6269", "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#5F6269", "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#5F6269", "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#5F6269", "bold": false, "italic": true,  "underline": false },
        "Information":    { "text-color": "#2C5D9B", "bold": false, "italic": false, "underline": false },
        "Warning":        { "text-color": "#9A4A14", "bold": false, "italic": false, "underline": false },
        "Alert":          { "text-color": "#A8365A", "bold": true,  "italic": false, "underline": false },
        "Error":          { "text-color": "#A8365A", "bold": true,  "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#9A4A14", "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#5E6168", "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#5E6168", "bold": false, "italic": false, "underline": false }
    }
}
