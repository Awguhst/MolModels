{
    "_comment": "Molecules & Models syntax theme (dark). Every token colour reaches >= 4.5:1 on the code background #101317; verified by scripts/check_contrast.py.",
    "text-color": "#E8E4DC",
    "background-color": "#101317",
    "line-number-color": "#8E8A82",
    "line-number-background-color": "#101317",
    "text-styles": {
        "Normal":         { "text-color": "#E8E4DC", "bold": false, "italic": false, "underline": false },
        "Keyword":        { "text-color": "#A9A4E6", "bold": false, "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#A9A4E6", "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#A9A4E6", "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#D0CCC4", "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#E39A6A", "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#6FC2B2", "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#86AEE0", "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#86AEE0", "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#E39AA9", "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#E8E4DC", "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#E3AA5C", "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#E3AA5C", "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#E3AA5C", "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#E3AA5C", "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#93C487", "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#D9A6D1", "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#93C487", "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#93C487", "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#93C487", "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#8E8A82", "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#8E8A82", "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#8E8A82", "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#8E8A82", "bold": false, "italic": true,  "underline": false },
        "Information":    { "text-color": "#86AEE0", "bold": false, "italic": false, "underline": false },
        "Warning":        { "text-color": "#E39A6A", "bold": false, "italic": false, "underline": false },
        "Alert":          { "text-color": "#E39AA9", "bold": true,  "italic": false, "underline": false },
        "Error":          { "text-color": "#E39AA9", "bold": true,  "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#E39A6A", "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#B9B1A6", "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#B9B1A6", "bold": false, "italic": false, "underline": false }
    }
}
