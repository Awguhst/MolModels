{
    "_comment": "Molecules & Models syntax theme (dark). Every token colour reaches >= 4.5:1 on the code background #0B0D11; verified by scripts/check_contrast.py.",
    "text-color": "#E6E9EE",
    "background-color": "#0B0D11",
    "line-number-color": "#6B7482",
    "line-number-background-color": "#0B0D11",
    "text-styles": {
        "Normal":         { "text-color": "#E6E9EE", "bold": false, "italic": false, "underline": false },
        "Keyword":        { "text-color": "#B9A8FF", "bold": false, "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#B9A8FF", "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#B9A8FF", "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#C9CED6", "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#F5A855", "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#5FD3C4", "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#7CC4FA", "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#7CC4FA", "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#FF8C7A", "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#E6E9EE", "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#F2B84B", "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#F2B84B", "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#F2B84B", "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#F2B84B", "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#8FDC8A", "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#F27BA6", "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#8FDC8A", "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#8FDC8A", "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#8FDC8A", "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#8B95A5", "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#8B95A5", "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#8B95A5", "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#8B95A5", "bold": false, "italic": true,  "underline": false },
        "Information":    { "text-color": "#7CC4FA", "bold": false, "italic": false, "underline": false },
        "Warning":        { "text-color": "#F5A855", "bold": false, "italic": false, "underline": false },
        "Alert":          { "text-color": "#FF8C7A", "bold": true,  "italic": false, "underline": false },
        "Error":          { "text-color": "#FF8C7A", "bold": true,  "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#F5A855", "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#9BB0FF", "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#9BB0FF", "bold": false, "italic": false, "underline": false }
    }
}
