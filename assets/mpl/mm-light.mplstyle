# Molecules & Models — matplotlib style (light rendering).
# The dark rendering is derived automatically from this one by _includes/mm-setup.qmd.
# Palette: colour-blind-safe (Okabe–Ito inspired), tuned to read on both page backgrounds.
figure.facecolor: FFFFFF
figure.edgecolor: FFFFFF
figure.autolayout: False
figure.constrained_layout.use: True
savefig.facecolor: FFFFFF
savefig.edgecolor: FFFFFF
savefig.bbox: tight
savefig.pad_inches: 0.06

axes.facecolor: FFFFFF
axes.edgecolor: 5B6573
axes.labelcolor: 1B1F27
axes.titlecolor: 1B1F27
axes.linewidth: 0.9
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.titlesize: 12.5
axes.titleweight: medium
axes.labelsize: 11
axes.titlepad: 10
axes.prop_cycle: cycler('color', ['5B4BD6', 'E69F00', '009E73', 'D55E00', '0072B2', 'CC79A7', '56B4E9', '7A7A7A'])

grid.color: D5DAE2
grid.linewidth: 0.6
grid.alpha: 1.0

xtick.color: 5B6573
ytick.color: 5B6573
xtick.labelcolor: 1B1F27
ytick.labelcolor: 1B1F27
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.5
ytick.major.size: 3.5

text.color: 1B1F27
font.family: sans-serif
font.sans-serif: IBM Plex Sans, DejaVu Sans, Arial, sans-serif
font.size: 11

legend.frameon: True
legend.framealpha: 0.92
legend.facecolor: FFFFFF
legend.edgecolor: D5DAE2
legend.fontsize: 10
legend.title_fontsize: 10.5

lines.linewidth: 1.9
lines.markersize: 5.5
patch.edgecolor: FFFFFF
patch.force_edgecolor: False
scatter.edgecolors: white
image.cmap: viridis
