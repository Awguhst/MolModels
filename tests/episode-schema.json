{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Molecules & Models episode front matter",
  "type": "object",
  "required": ["title", "chapter", "episode", "teaching", "exercises", "level", "questions", "objectives", "keypoints"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "chapter": { "type": "integer", "minimum": 0, "maximum": 15 },
    "episode": { "type": "integer", "minimum": 1, "maximum": 12 },
    "teaching": { "type": "integer", "minimum": 5, "maximum": 90 },
    "exercises": { "type": "integer", "minimum": 0, "maximum": 60 },
    "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "questions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 8 } },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 8 } },
    "keypoints": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 8 } },
    "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "^ch[0-9]{2}-(ep|lab)[0-9]{2}$" } }
  }
}
